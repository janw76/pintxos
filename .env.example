# Read by docker compose, and by the native `pintxos` command when run from this directory.

# Set the key for your model's provider. Setting both is fine; local: models need no key.
# OpenRouter: the default model z-ai/glm-5.3-flash and any model with a slash.
OPENROUTER_API_KEY=

# Anthropic direct: a model without a slash. Anthropic-only setup: set this key and
# PINTXOS_MODEL=claude-haiku-4-5-20251001 (no OpenRouter key needed).
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown in README):
# PINTXOS_MODEL=z-ai/glm-5.3-flash (a slash in the name routes to OpenRouter instead of Anthropic)
# PINTXOS_POLL_MINUTES=30
# PINTXOS_ITEMS_PER_FEED=50
# PINTXOS_BASE_URL=
# PINTXOS_DATA_DIR=./data
# PINTXOS_HOST=127.0.0.1
# PINTXOS_PORT=8000
