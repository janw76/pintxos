# Read by docker compose, and by the native `pintxos` command when run from this directory.
ANTHROPIC_API_KEY=

# Only needed for models with a slash, e.g. google/gemini-2.5-flash-lite
OPENROUTER_API_KEY=

# Optional overrides (defaults shown in README):
# PINTXOS_MODEL=claude-haiku-4-5-20251001 (a slash in the name routes to OpenRouter instead of Anthropic)
# PINTXOS_POLL_MINUTES=30
# PINTXOS_ITEMS_PER_FEED=50
# PINTXOS_BASE_URL=
# PINTXOS_DATA_DIR=./data
# PINTXOS_HOST=127.0.0.1
# PINTXOS_PORT=8000
