#!/usr/bin/env bash
# bin/deploy deploys origin/main's release build on patito through the deploy key,
# via the shared deploy-via-patito helper (CI wait, key call, health poll).
# First output line is the previously running version.
# bin/deploy <version> exits 2: there is no rollback form; revert on main and deploy again.
set -euo pipefail
cd "$(dirname "$0")/.."  # the helper and next_version.py both need the repo root

[ $# -eq 0 ] || { echo "no rollback: revert the change on main and deploy again" >&2; exit 2; }

git fetch -q --tags origin main
sha=$(git rev-parse origin/main)
version=$(git tag --points-at "$sha" 'v[0-9]*' | sort -V | tail -n1)
version=${version#v}
if [ -z "$version" ]; then
  # ponytail: CI has not tagged yet, so guess with the computation CI runs. Wrong if an
  # earlier main commit's build is still in flight or across a month boundary (local time here, UTC in CI); the
  # health poll then fails loudly and a re-run picks up the real tag. Upgrade path: wait
  # for the tag before calling the helper.
  version=$(python3 scripts/next_version.py)
fi

exec deploy-via-patito pintxos build "${PINTXOS_DEPLOY_URL:-http://patito:8087}/health" 'curl -sf "$1" | jq -r .version' "$version"
